# --- Postgres ---
POSTGRES_DB=teloconsiglio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- JWT ---
JWT__Key=ChangeMe_TeLoConsiglio_SuperSecret_Key_AtLeast32Chars_12345!
JWT__Issuer=TeLoConsiglio
JWT__Audience=TeLoConsiglio

# --- Google Gemini AI (optional, but features AI sono disabled senza chiave) ---
# Ottieni una API key gratis (no carta richiesta): https://aistudio.google.com/apikey
# Free tier: 1500 req/giorno, 1M token contesto, gratis sui modelli "flash".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Budget AI mensile per utente in USD (default 5.0). Oltre il cap: 429 ---
BUDGET_MONTHLY_USD=5.0

# --- OAuth providers (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Chiave AES-256 per cifrare i documenti caricati (base64 di 32 byte) ---
# Genera con: openssl rand -base64 32
# Se mancante i file sono salvati in chiaro (fallback retrocompatibile).
# ATTENZIONE: se la chiave viene persa, i file cifrati diventano irrecuperabili.
DOC_ENCRYPTION_KEY=

# --- Email (opzionale; se mancante, gli inviti vengono solo loggati su stdout) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@teloconsiglio.io
SMTP_USE_SSL=true

# --- Frontend / CORS ---
Frontend__Url=http://localhost:8080
VITE_API_URL=http://localhost:5000
